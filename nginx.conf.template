server {
    listen 82;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    location ~ ^/(auth|rest|realtime|storage|functions|graphql)/v1/ {
        proxy_pass http://api.supabase.internal:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location /api/protheus/bos {
        proxy_pass https://api.tidelli.com.br/pedidos/bos;
        proxy_redirect off;
        proxy_ssl_server_name on;
        proxy_ssl_name api.tidelli.com.br;
        proxy_set_header X-API-Key "${PROTHEUS_API_KEY}";
        proxy_set_header Host api.tidelli.com.br;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ /\. {
        deny all;
    }
}